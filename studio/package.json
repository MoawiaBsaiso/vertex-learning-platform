{
  "name": "vertex-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "start": "sanity start",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "extract-schema": "tsx --env-file=.env.local scripts/extract-schema.ts",
    "typegen": "npm run extract-schema && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/icons": "3.8.0",
    "@sanity/vision": "^5.31.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^5.31.2",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
