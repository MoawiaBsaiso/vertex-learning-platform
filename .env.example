# Canonical environment list. Copy to .env.local and fill in. Never commit real values.
# The root .env.local serves the Next.js app. Copy the Studio block into studio/.env.local.

# Sanity (private dataset; tokens are server only)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Standalone Sanity Studio (public identifiers only; studio/.env.local)
# The offline video ingestion CLI also reads SANITY_API_READ_TOKEN and
# SANITY_API_WRITE_TOKEN from studio/.env.local. Tokens are never printed.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
SANITY_STUDIO_API_VERSION=

# Sanity Context MCP endpoint (server only)
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=

# Clerk (publishable key is browser safe; secret key is server only)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Gemini (server only)
GEMINI_API_KEY=
GEMINI_SEARCH_MODEL=gemini-2.5-flash

# PostHog (project key and host are browser safe; never add a private key here)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
